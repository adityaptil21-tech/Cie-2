@model ContactMessage
@{ ViewData["Title"] = "Contact Us"; }

<section class="page-header">
    <div class="container"><h1>Contact <span class="text-gradient">Us</span></h1><p class="text-muted mb-0 mt-2">We are here to help, day and night.</p></div>
</section>

<div class="container pb-4">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card p-4 mb-3"><div class="d-flex gap-3"><div class="info-icon"><i class="bi bi-geo-alt"></i></div><div><h6 class="mb-1">Address</h6><p class="text-muted mb-0">123 Health Avenue, Medical Square, India – 380001</p></div></div></div>
            <div class="card p-4 mb-3"><div class="d-flex gap-3"><div class="info-icon"><i class="bi bi-telephone"></i></div><div><h6 class="mb-1">Phone</h6><p class="text-muted mb-0">+91 98765 43210 (24x7 Emergency)</p></div></div></div>
            <div class="card p-4 mb-3"><div class="d-flex gap-3"><div class="info-icon"><i class="bi bi-envelope"></i></div><div><h6 class="mb-1">Email</h6><p class="text-muted mb-0">info@careplushospital.in</p></div></div></div>
            <div class="card p-4"><div class="d-flex gap-3"><div class="info-icon"><i class="bi bi-clock"></i></div><div><h6 class="mb-1">OPD Hours</h6><p class="text-muted mb-0">Mon – Sat: 8:00 AM – 8:00 PM<br />Sunday: Emergency only</p></div></div></div>
        </div>
        <div class="col-lg-7">
            <div class="card form-card"><div class="card-body p-4 p-md-5">
                <h4 class="mb-4">Send us a message</h4>
                <form asp-action="Contact" method="post">
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
                        <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="field-validation-error"></span></div>
                        <div class="col-12"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="field-validation-error"></span></div>
                        <div class="col-12"><label asp-for="Message" class="form-label"></label><textarea asp-for="Message" rows="4" class="form-control"></textarea><span asp-validation-for="Message" class="field-validation-error"></span></div>
                        <div class="col-12"><button type="submit" class="btn btn-primary btn-pill"><i class="bi bi-send me-1"></i> Send Message</button></div>
                    </div>
                </form>
            </div></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
