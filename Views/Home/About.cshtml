@{ ViewData["Title"] = "About Us"; }

<section class="page-header">
    <div class="container"><h1>About <span class="text-gradient">CarePlus Hospital</span></h1><p class="text-muted mb-0 mt-2">Caring for our community for over 25 years.</p></div>
</section>

<div class="container pb-4">
    <div class="row g-5 align-items-center mb-5">
        <div class="col-lg-7">
            <h3 class="mb-3">Our Story</h3>
            <p class="text-muted">CarePlus Hospital began as a 30-bed clinic with a simple belief: every patient deserves timely, honest and compassionate care. Today we are a 200-bed multispecialty hospital with advanced diagnostics, modern operation theatres and a dedicated emergency department.</p>
            <p class="text-muted">Our doctors, nurses and support staff work together to give every patient personal attention, clear communication and transparent pricing, with all charges shown in Indian rupees (₹).</p>
        </div>
        <div class="col-lg-5">
            <div class="row g-3 text-center">
                <div class="col-6"><div class="card p-4"><h3 class="text-gradient mb-0">200</h3><small class="text-muted">Beds</small></div></div>
                <div class="col-6"><div class="card p-4"><h3 class="text-gradient mb-0">50+</h3><small class="text-muted">Specialists</small></div></div>
                <div class="col-6"><div class="card p-4"><h3 class="text-gradient mb-0">25+</h3><small class="text-muted">Years of Service</small></div></div>
                <div class="col-6"><div class="card p-4"><h3 class="text-gradient mb-0">24x7</h3><small class="text-muted">Emergency</small></div></div>
            </div>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-md-4"><div class="card hover-lift p-4 h-100"><div class="service-icon"><i class="bi bi-bullseye"></i></div><h5>Our Mission</h5><p class="text-muted mb-0">To deliver accessible, high-quality healthcare with empathy and integrity.</p></div></div>
        <div class="col-md-4"><div class="card hover-lift p-4 h-100"><div class="service-icon"><i class="bi bi-eye"></i></div><h5>Our Vision</h5><p class="text-muted mb-0">To be the most trusted healthcare partner for families in our region.</p></div></div>
        <div class="col-md-4"><div class="card hover-lift p-4 h-100"><div class="service-icon"><i class="bi bi-heart"></i></div><h5>Our Values</h5><p class="text-muted mb-0">Compassion, excellence, transparency and respect for every patient.</p></div></div>
    </div>
</div>
