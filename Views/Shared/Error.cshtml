@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<section class="container py-5 text-center">
    <div class="error-box mx-auto">
        <div class="display-1 fw-bold text-gradient">@(Model.Code?.ToString() ?? "Oops")</div>
        <h2 class="mb-3">@(Model.Code == 404 ? "Page not found" : "Something went wrong")</h2>
        <p class="text-muted">@(Model.Code == 404
            ? "The page or doctor you are looking for does not exist."
            : "An unexpected error occurred. Please try again in a moment.")</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-pill mt-2"><i class="bi bi-house me-1"></i> Back to Home</a>
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="small text-muted mt-4 mb-0">Request ID: <code>@Model.RequestId</code></p>
        }
    </div>
</section>
