@model Doctor
<div class="card doctor-card h-100">
    <div class="card-body p-4 text-center d-flex flex-column">
        <div class="doctor-avatar mx-auto mb-3"><i class="bi @Model.IconClass"></i></div>
        <span class="badge badge-specialty mx-auto mb-2">@Model.Specialization</span>
        <h5 class="fw-semibold mb-1">@Model.DoctorName</h5>
        <p class="text-muted small mb-3">@Model.Qualification</p>
        <div class="d-flex justify-content-center gap-4 small mb-4">
            <span><i class="bi bi-award text-teal me-1"></i>@Model.Experience yrs exp.</span>
            <span class="fw-semibold"><i class="bi bi-wallet2 text-teal me-1"></i>@Model.ConsultationFee.ToRupees()</span>
        </div>
        <a asp-controller="Doctors" asp-action="Details" asp-route-doctorId="@Model.DoctorId" class="btn btn-outline-primary btn-pill mt-auto">
            View Details <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</div>
