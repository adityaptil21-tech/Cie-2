@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) => controller == c && (a == null || action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CarePlus Hospital</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg sticky-top app-navbar">
        <div class="container">
            <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon"><i class="bi bi-hospital"></i></span>
                <span>Care<span class="text-teal">Plus</span> Hospital</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-2"></i>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link @Active("Home", "Index")" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Doctors")" asp-controller="Doctors" asp-action="Index">Doctors</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Posts")" asp-controller="Posts" asp-action="Index">Posts</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Home", "About")" asp-controller="Home" asp-action="About">About</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Home", "Contact")" asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>
                <a class="btn btn-primary btn-pill" asp-controller="Appointments" asp-action="Create">
                    <i class="bi bi-calendar2-plus me-1"></i> Book Appointment
                </a>
            </div>
        </div>
    </nav>

    <main>
        <div class="container pt-3">
            @if (TempData["Success"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="brand text-white mb-3"><span class="brand-icon"><i class="bi bi-hospital"></i></span> CarePlus Hospital</div>
                    <p class="footer-text">Compassionate, affordable and world-class healthcare for you and your family, available 24x7.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="text-white">Quick Links</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Doctors" asp-action="Index">Doctors</a></li>
                        <li><a asp-controller="Appointments" asp-action="Create">Book Appointment</a></li>
                        <li><a asp-controller="Posts" asp-action="Index">Posts</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="text-white">Hospital</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="text-white">Contact</h6>
                    <ul class="list-unstyled footer-text">
                        <li class="mb-2"><i class="bi bi-geo-alt me-2 text-teal"></i>123 Health Avenue, Medical Square, India</li>
                        <li class="mb-2"><i class="bi bi-telephone me-2 text-teal"></i>+91 98765 43210</li>
                        <li class="mb-2"><i class="bi bi-envelope me-2 text-teal"></i>info@careplushospital.in</li>
                        <li><i class="bi bi-clock me-2 text-teal"></i>Open 24 x 7 for emergencies</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary mt-4" />
            <p class="text-center footer-text mb-0 small">&copy; @DateTime.Now.Year CarePlus Hospital. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
